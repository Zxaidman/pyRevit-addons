<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="AnonGee · Auto Level Manager"
        Height="820" Width="1280"
        MinHeight="660" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF4F4F6"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri">

    <Window.Resources>
        <ResourceDictionary>

            <!-- ═══ AnonGee BIM Tools — Inlined Theme v3.2 ═══
                 Verbatim from Dev.panel/Modeless.pushbutton/ui.xaml, which is
                 the sanctioned inline copy of Resources/*.xaml (§12.3 / §12.7.B).
                 Tool-specific additions are grouped at the end of the block. -->

            <!-- ── Colors ── -->
            <Color x:Key="ColorVividRed">#FFE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorSilverSteel">#FFC0C8D8</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorOffWhite">#FFF4F4F6</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorLightBorder">#FFE2E4EA</Color>
            <Color x:Key="ColorSuccessGreen">#FF16A34A</Color>
            <Color x:Key="ColorErrorRed">#FFDC2626</Color>
            <Color x:Key="ColorVividRedHover">#FFC41A1A</Color>
            <Color x:Key="ColorVividRedPressed">#FFA81515</Color>
            <Color x:Key="ColorErrorRedHover">#FFB91C1C</Color>
            <Color x:Key="ColorErrorRedPressed">#FF991B1B</Color>
            <Color x:Key="ColorVividRed10">#1AE02020</Color>
            <Color x:Key="ColorOffWhiteHover">#FFE8E8EC</Color>

            <SolidColorBrush x:Key="BrushVividRed"            Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushCharcoalBlack"       Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushSilverSteel"         Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPureWhite"           Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushOffWhite"            Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"             Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushLightBorder"         Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushSuccessGreen"        Color="{StaticResource ColorSuccessGreen}"/>
            <SolidColorBrush x:Key="BrushErrorRed"            Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushVividRedHover"       Color="{StaticResource ColorVividRedHover}"/>
            <SolidColorBrush x:Key="BrushVividRedPressed"     Color="{StaticResource ColorVividRedPressed}"/>
            <SolidColorBrush x:Key="BrushErrorRedHover"       Color="{StaticResource ColorErrorRedHover}"/>
            <SolidColorBrush x:Key="BrushErrorRedPressed"     Color="{StaticResource ColorErrorRedPressed}"/>
            <SolidColorBrush x:Key="BrushSecondaryHover"      Color="{StaticResource ColorVividRed10}"/>
            <SolidColorBrush x:Key="BrushGhostHover"          Color="{StaticResource ColorOffWhiteHover}"/>
            <SolidColorBrush x:Key="BrushDisabledBackground"  Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDisabledForeground"  Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPrimaryForeground"   Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBackground" Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBorder"     Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushSecondaryForeground" Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushNeutralBackground"   Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushNeutralForeground"   Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushNeutralBorder"       Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushGhostForeground"     Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushInputBackground"     Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushInputBorder"         Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushInputFocusBorder"    Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushTableRowHover"          Color="#FDECEA"/>
            <SolidColorBrush x:Key="BrushTableRowSelected"       Color="#FEF2F2"/>
            <SolidColorBrush x:Key="BrushSuccessBadgeBackground" Color="#DCFCE7"/>
            <SolidColorBrush x:Key="BrushSuccessBadgeText"       Color="#15803D"/>
            <SolidColorBrush x:Key="BrushErrorBadgeBackground"   Color="#FEE2E2"/>
            <SolidColorBrush x:Key="BrushErrorBadgeText"         Color="#991B1B"/>
            <SolidColorBrush x:Key="BrushInfoBadgeBackground"    Color="#DBEAFE"/>
            <SolidColorBrush x:Key="BrushInfoBadgeText"          Color="#1D4ED8"/>

            <!-- ── Elevation ── -->
            <DropShadowEffect x:Key="ElevationLevel2"
                              Color="#000000" Opacity="0.14" BlurRadius="12" ShadowDepth="4" Direction="270"/>

            <!-- ── Typography ── -->
            <FontFamily x:Key="FontSans">JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri</FontFamily>
            <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>
            <sys:Double x:Key="FontSizeH2">16.5</sys:Double>
            <sys:Double x:Key="FontSizeH3">12</sys:Double>
            <sys:Double x:Key="FontSizeBody">10.5</sys:Double>
            <sys:Double x:Key="FontSizeCaption">9</sys:Double>

            <Style x:Key="TextH2OnDark" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH2}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushPureWhite}"/>
            </Style>
            <Style x:Key="TextH3" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH3}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>

            <!-- ── Buttons ── -->
            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="14,0"/>
                <Setter Property="Height"          Value="32"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushVividRed}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushSecondaryBackground}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushSecondaryForeground}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushSecondaryBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSecondaryHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonNeutral" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"  Value="{StaticResource BrushNeutralBackground}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushNeutralForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushNeutralBorder}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushLightBorder}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushGhostForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushGhostHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TextBox (stroke-on-top, §12.7.O) ── -->
            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background"  Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ComboBox — supports editable AND non-editable (§12.7.C) ── -->
            <Style x:Key="InputComboBox" TargetType="ComboBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ToggleButton x:Name="OpenToggle" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                      Fill="{StaticResource BrushMidGrey}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Margin="8,0,24,0"
                                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <TextBox x:Name="PART_EditableTextBox" Margin="6,0,24,0"
                                         VerticalAlignment="Center" Visibility="Hidden"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource BrushCharcoalBlack}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border MinWidth="{TemplateBinding ActualWidth}" MaxWidth="520"
                                            BorderBrush="{StaticResource BrushLightBorder}"
                                            BorderThickness="1" CornerRadius="6"
                                            Background="{StaticResource BrushPureWhite}"
                                            Effect="{StaticResource ElevationLevel2}">
                                        <ScrollViewer MaxHeight="220" Margin="4" HorizontalScrollBarVisibility="Hidden">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite"          Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily"  Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"    Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"  Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="Padding"     Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Toggle switch (§9.9) ── -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="MinHeight"  Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Border x:Name="Track" Grid.Column="1"
                                        Width="38" Height="20" CornerRadius="10"
                                        Background="{StaticResource BrushSilverSteel}"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Ellipse x:Name="Thumb" Width="16" Height="16"
                                             Fill="{StaticResource BrushPureWhite}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbShift" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background"
                                            Value="{StaticResource BrushVividRed}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="18" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Track" Property="Background"
                                            Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Grid checkbox (DataGrid ✓ column) ── -->
            <Style x:Key="GridCheckBox" TargetType="CheckBox">
                <Setter Property="Cursor"              Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment"   Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                    Background="{StaticResource BrushPureWhite}">
                                <Viewbox x:Name="CheckMark" Margin="3" Visibility="Collapsed">
                                    <Path Data="M0,3.5 L3.5,7 L9,0"
                                          Stroke="{StaticResource BrushPureWhite}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="Background"  Value="{StaticResource BrushVividRed}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Tab-style RadioButton (operation modes) ── -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Margin"     Value="0,0,18,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Padding="0,0,0,5">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ListBox item ── -->
            <Style TargetType="ListBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Padding"    Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ScrollBar (both orientations, §12.7.P) ── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width"    Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="2,0"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="2,0"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height"    Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="0,2"/>
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="0,2"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── Card ── -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushLightBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16"/>
            </Style>

            <!-- ═══ Auto Level Manager additions ═══ -->

            <!-- Compact button for the grid toolbar -->
            <Style x:Key="ButtonSmall" TargetType="Button" BasedOn="{StaticResource ButtonNeutral}">
                <Setter Property="Height"   Value="26"/>
                <Setter Property="Padding"  Value="10,0"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Margin"   Value="0,0,6,0"/>
            </Style>
            <Style x:Key="ButtonSmallDanger" TargetType="Button" BasedOn="{StaticResource ButtonSmall}">
                <Setter Property="Foreground"  Value="{StaticResource BrushErrorRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBadgeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushErrorBadgeBackground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact input for the dense option rows -->
            <Style x:Key="InputSmall" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                <Setter Property="Height"   Value="26"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            </Style>
            <Style x:Key="ComboSmall" TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}">
                <Setter Property="Height"   Value="26"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            </Style>
            <Style x:Key="ToggleSmall" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                <Setter Property="FontSize"  Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="MinHeight" Value="20"/>
            </Style>
            <Style x:Key="RadioInline" TargetType="RadioButton" BasedOn="{StaticResource TabRadio}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Margin"   Value="0,0,14,0"/>
            </Style>

            <!-- Grid cell text -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="FontFamily"        Value="{StaticResource FontSans}"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="FontFamily"          Value="{StaticResource FontMono}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Padding"             Value="0,0,10,0"/>
            </Style>
            <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- MAIN LAYOUT -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 header -->
            <RowDefinition Height="3"/>      <!-- 1 accent rule -->
            <RowDefinition Height="*"/>      <!-- 2 body -->
            <RowDefinition Height="Auto"/>   <!-- 3 footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="{StaticResource BrushCharcoalBlack}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Auto Level Manager" Style="{StaticResource TextH2OnDark}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{StaticResource BrushVividRed}" CornerRadius="3"
                        Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="SMART TEXT DETECTION"
                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushPureWhite}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
        <Rectangle Grid.Row="1" Fill="{StaticResource BrushVividRed}"/>

        <!-- ── Body ── -->
        <Grid Grid.Row="2" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the level stack, drawn to scale — and editable in place -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- title + span badge -->
                        <RowDefinition Height="*"/>      <!-- the drawing -->
                        <RowDefinition Height="Auto"/>   <!-- zoom + snap -->
                        <RowDefinition Height="Auto"/>   <!-- legend + hint -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Level Stack" Style="{StaticResource TextH3}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushOffWhite}" CornerRadius="3"
                                Padding="7,2" VerticalAlignment="Center"
                                ToolTip="The height on screen, and the zoom factor when you are zoomed in.">
                            <TextBlock x:Name="HeightBadgeText" Text="—"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushMidGrey}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource BrushOffWhite}" CornerRadius="6"
                            ClipToBounds="True">
                        <Canvas x:Name="StackCanvas" Background="Transparent" Cursor="Hand">
                            <Canvas.ToolTip>
                                <TextBlock>
                                    Click a level to select it.<LineBreak/>
                                    Drag a level up or down to change its elevation.<LineBreak/>
                                    Double-click a level to rename it in the grid.<LineBreak/>
                                    Wheel zooms · Shift+wheel pans · drag empty space to pan.
                                </TextBlock>
                            </Canvas.ToolTip>
                        </Canvas>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="ZoomOutBtn" Content="–" Width="26"
                                    Style="{StaticResource ButtonSmall}"
                                    ToolTip="Zoom out. The mouse wheel does this too."/>
                            <Button x:Name="ZoomInBtn" Content="+" Width="26"
                                    Style="{StaticResource ButtonSmall}"
                                    ToolTip="Zoom in on the middle of the view, so levels drawn on top of each other separate."/>
                            <Button x:Name="ZoomFitBtn" Content="Fit" Width="42"
                                    Style="{StaticResource ButtonSmall}"
                                    ToolTip="Back to the whole stack in one screen."/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Snap" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="2" x:Name="SnapCombo" Width="76"
                                  Style="{StaticResource ComboSmall}"
                                  ToolTip="Dragging a level rounds it to this. Hold Shift while dragging for no rounding."/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <WrapPanel>
                            <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{StaticResource BrushCharcoalBlack}" VerticalAlignment="Center"/>
                            <TextBlock Text="in model" Style="{StaticResource TextCaption}" Margin="0,0,12,0"/>
                            <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{StaticResource BrushVividRed}" VerticalAlignment="Center"/>
                            <TextBlock Text="new" Style="{StaticResource TextCaption}" Margin="0,0,12,0"/>
                            <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{StaticResource BrushInfoBadgeText}" VerticalAlignment="Center"/>
                            <TextBlock Text="edited" Style="{StaticResource TextCaption}" Margin="0,0,12,0"/>
                            <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{StaticResource BrushSilverSteel}" VerticalAlignment="Center"/>
                            <TextBlock Text="delete" Style="{StaticResource TextCaption}"/>
                        </WrapPanel>
                        <TextBlock x:Name="StackHint" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Drag a level to move it · double-click to rename · wheel to zoom."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: tabs, toolbar, grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- tabs -->
                    <RowDefinition Height="Auto"/>   <!-- tab panel -->
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- grid -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Numbered because the tabs are a sequence, not a menu:
                         find the levels, add what's missing, name them, give
                         them views, apply. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="TabDetect"   Content="1 · Detect"   GroupName="AutoLevelTabs"
                                     Style="{StaticResource TabRadio}" IsChecked="True"
                                     ToolTip="Read levels out of drawing text, a DXF, or pasted lines."/>
                        <RadioButton x:Name="TabGenerate" Content="2 · Generate" GroupName="AutoLevelTabs"
                                     Style="{StaticResource TabRadio}"
                                     ToolTip="Add levels by count and storey height, named to match the model."/>
                        <RadioButton x:Name="TabRename"   Content="3 · Rename"   GroupName="AutoLevelTabs"
                                     Style="{StaticResource TabRadio}"
                                     ToolTip="Batch rename or renumber the levels you have ticked."/>
                        <RadioButton x:Name="TabViews"    Content="4 · Views"    GroupName="AutoLevelTabs"
                                     Style="{StaticResource TabRadio}"
                                     ToolTip="Plan views for new levels, and the summary of what Apply will do."/>
                    </StackPanel>
                    <RadioButton Grid.Column="1" x:Name="TabGuide" Content="Guide"
                                 GroupName="AutoLevelTabs" Style="{StaticResource TabRadio}"
                                 Margin="18,0,0,0"
                                 ToolTip="What this tool does and how to drive it. Start here."/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- One line saying what this tab is for, swapped in script.py. -->
                        <Border Grid.Row="0" Background="#FEF2F2" CornerRadius="5" Padding="10,6"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="TabHint" Style="{StaticResource TextCaption}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushCharcoalBlack}"
                                       Text="Pick where the levels are written, then press Scan for levels."/>
                        </Border>

                        <Grid Grid.Row="1">

                        <!-- ══ DETECT ══ -->
                        <Grid x:Name="PanelDetect">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- source + options -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Read levels from" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="SourceCombo" ToolTip="Where the level text lives. Active view reads the text notes and spot elevations you can see; Selection reads only what you pick in Revit; DXF reads the file itself." Style="{StaticResource ComboSmall}"/>
                                    <Button Grid.Column="1" x:Name="BrowseBtn" ToolTip="Pick a .dxf on disk. DWG cannot be read directly - save it as DXF, or scan the model's own text instead." Content="Browse…"
                                            Style="{StaticResource ButtonSmall}" Margin="6,0,0,0"
                                            Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="SourcePathText" Style="{StaticResource TextCaption}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                           Text="Scans text notes and spot elevations in the active view."/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Drawing unit"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Datum offset (mm)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Match ± (mm)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="UnitCombo" ToolTip="Leave on Auto-detect: the tool works out mm / cm / m / feet from the storey heights the numbers imply. Set it by hand only when Auto gets it wrong."
                                              Style="{StaticResource ComboSmall}"/>
                                    <TextBox  Grid.Row="1" Grid.Column="2" x:Name="DatumInput" ToolTip="Subtracted from every detected value. Use it when the drawing is on a site datum - enter 100000 to turn RL 100.000 into 0."
                                              Style="{StaticResource InputSmall}" Text="0"/>
                                    <TextBox  Grid.Row="1" Grid.Column="4" x:Name="ToleranceInput" ToolTip="How close a detected level has to be to an existing one to count as the same level rather than a new one."
                                              Style="{StaticResource InputSmall}" Text="25"/>
                                </Grid>

                                <TextBlock Text="DXF layers (optional, comma separated)"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                <TextBox x:Name="LayerInput" ToolTip="DXF only. Leave empty to read every layer, or name the text layers to read, separated by commas." Style="{StaticResource InputSmall}"
                                         Margin="0,0,0,8"/>

                                <WrapPanel>
                                    <CheckBox x:Name="EvidenceToggle" ToolTip="On, a number only counts as a level if it has a level word (FFL, LVL, TOS) or a sign. Turn it off for a bare list of numbers - and expect more noise." Style="{StaticResource ToggleSmall}"
                                              IsChecked="True" Margin="0,0,16,6"
                                              Content="Need a level word or a sign"/>
                                    <CheckBox x:Name="PositionToggle" ToolTip="Checks each text against where it sits on the sheet. A value that contradicts its own position is flagged instead of quietly creating a level in the wrong place." Style="{StaticResource ToggleSmall}"
                                              IsChecked="True" Margin="0,0,16,6"
                                              Content="Cross-check text positions"/>
                                    <CheckBox x:Name="AdoptToggle" ToolTip="When a detected level matches one already in the model, take the drawing's name for it. Turn off to keep the model's names." Style="{StaticResource ToggleSmall}"
                                              IsChecked="True" Margin="0,0,16,6"
                                              Content="Rename matching levels"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- paste + run -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Or paste level text — one per line"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <Border Grid.Row="1" Background="{StaticResource BrushPureWhite}"
                                        BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                        CornerRadius="5" MinHeight="86" Margin="0,0,0,8">
                                    <TextBox x:Name="PasteInput" ToolTip="Paste level text here, one per line, then press Read pasted text. Anything the detector understands works." AcceptsReturn="True" TextWrapping="NoWrap"
                                             BorderThickness="0" Background="Transparent" Padding="8,6"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="{StaticResource FontSizeCaption}"
                                             Foreground="{StaticResource BrushCharcoalBlack}"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="ScanBtn" ToolTip="Read the source above and stage what it finds in the table. Nothing is written to the model." Content="Scan for levels"
                                            Style="{StaticResource ButtonPrimary}" Width="150" Margin="0,0,8,0"/>
                                    <Button x:Name="ParsePasteBtn" ToolTip="Read the paste box instead of the source above." Content="Read pasted text"
                                            Style="{StaticResource ButtonSecondary}" Width="150"/>
                                </StackPanel>

                                <Border Grid.Row="3" Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                                        Padding="10,7">
                                    <TextBlock x:Name="DetectSummary" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap"
                                               Text="Nothing scanned yet. Open a section or elevation, then Scan — Revit stays interactive while this window is open."/>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ══ GENERATE ══ -->
                        <Grid x:Name="PanelGenerate" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="How many"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Storey height (mm)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Start above"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox  Grid.Row="1" Grid.Column="0" x:Name="CountInput" ToolTip="How many levels to add above the starting point."
                                              Style="{StaticResource InputSmall}" Text="4"/>
                                    <TextBox  Grid.Row="1" Grid.Column="2" x:Name="HeightInput" ToolTip="Floor-to-floor height for the levels being added. Re-space also uses this."
                                              Style="{StaticResource InputSmall}" Text="3000"/>
                                    <ComboBox Grid.Row="1" Grid.Column="4" x:Name="BaseCombo" ToolTip="The level the new ones stack on top of. Top of the stack means the highest level there is."
                                              Style="{StaticResource ComboSmall}"/>
                                </Grid>

                                <TextBlock Text="Name them" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="FollowRadio" ToolTip="Continue the model's own naming - 02 2ND FLOOR LVL. becomes 03 3RD FLOOR LVL. Falls back to the template if there is no pattern to follow." Content="Follow the model"
                                                 GroupName="AutoLevelNaming" Style="{StaticResource RadioInline}"
                                                 IsChecked="True"/>
                                    <RadioButton x:Name="TemplateRadio" ToolTip="Name them from the template instead of copying the model." Content="Use a template"
                                                 GroupName="AutoLevelNaming" Style="{StaticResource RadioInline}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Template"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Start at"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="TemplateInput" ToolTip="{n} 1 - {nn} 01 - {nnn} 001 - {ordinal} 1st - {ORDINAL} 1ST - {Word} First - {roman} I - {elev_m} 3.500 - {elev_mm} 3500"
                                             Style="{StaticResource InputSmall}" Text="Level {n}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="StartInput" ToolTip="First number to use. Leave empty to carry on from the highest number already in use."
                                             Style="{StaticResource InputSmall}"/>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Preview" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4"/>
                                <Border Grid.Row="1" Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                                        Padding="10,8" MinHeight="86" Margin="0,0,0,8">
                                    <TextBlock x:Name="NamePreview" Style="{StaticResource TextCaption}"
                                               FontFamily="{StaticResource FontMono}" TextWrapping="Wrap"
                                               Text="—"/>
                                </Border>

                                <StackPanel Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="GenerateBtn" ToolTip="Stage the new levels in the table. Nothing is written to the model." Content="Add levels"
                                                Style="{StaticResource ButtonPrimary}" Width="130" Margin="0,0,8,0"/>
                                        <Button x:Name="RespaceBtn" ToolTip="Re-space every level above the starting point to the storey height, evenly." Content="Re-space stack"
                                                Style="{StaticResource ButtonSecondary}" Width="150"/>
                                    </StackPanel>
                                    <CheckBox x:Name="PushAboveToggle" ToolTip="On, changing one level's elevation moves everything above it by the same amount, keeping the storey heights. Off, only that level moves." Style="{StaticResource ToggleSmall}"
                                              Content="Editing an elevation pushes the levels above it"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ══ RENAME ══ -->
                        <Grid x:Name="PanelRename" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Prefix"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Suffix"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="PrefixInput" ToolTip="Put this in front of each name."
                                             Style="{StaticResource InputSmall}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="SuffixInput" ToolTip="Put this after each name."
                                             Style="{StaticResource InputSmall}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Find"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Replace with"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="4" Grid.Column="0" x:Name="FindInput" ToolTip="Text to look for in each name."
                                             Style="{StaticResource InputSmall}"/>
                                    <TextBox Grid.Row="4" Grid.Column="2" x:Name="ReplaceInput" ToolTip="What to put in its place. Leave empty to delete the found text."
                                             Style="{StaticResource InputSmall}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Case"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Apply to"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CaseCombo" ToolTip="Force the whole name to a case, or leave it as typed."
                                              Style="{StaticResource ComboSmall}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <RadioButton x:Name="ScopeSelectedRadio" ToolTip="Rename only the rows ticked in the table." Content="Ticked rows"
                                                     GroupName="AutoLevelScope"
                                                     Style="{StaticResource RadioInline}" IsChecked="True"/>
                                        <RadioButton x:Name="ScopeAllRadio" ToolTip="Rename every level, ticked or not." Content="Every level"
                                                     GroupName="AutoLevelScope"
                                                     Style="{StaticResource RadioInline}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" x:Name="RenameTemplateToggle" ToolTip="Renumber from scratch with a template instead of editing the names you have."
                                          Style="{StaticResource ToggleSmall}" Margin="0,0,0,6"
                                          Content="Renumber with a template instead"/>
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="RenameTemplateInput" ToolTip="Same tokens as the Generate tab: {n} {nn} {ORDINAL} {Word} {roman} {elev_m} {elev_mm}"
                                             Style="{StaticResource InputSmall}" Text="{}{nn} {ORDINAL} FLOOR"
                                             IsEnabled="False"/>
                                    <TextBox Grid.Column="2" x:Name="RenameStartInput" ToolTip="Number to give the lowest renamed level."
                                             Style="{StaticResource InputSmall}" Text="1" IsEnabled="False"/>
                                </Grid>

                                <Border Grid.Row="2" Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                                        Padding="10,8" MinHeight="60" Margin="0,0,0,8">
                                    <TextBlock x:Name="RenamePreview" Style="{StaticResource TextCaption}"
                                               FontFamily="{StaticResource FontMono}" TextWrapping="Wrap"
                                               Text="Tick the rows to rename, then fill in a rule."/>
                                </Border>

                                <Button Grid.Row="3" x:Name="ApplyRenameBtn" ToolTip="Stage the renames in the table. A name that would clash is skipped and reported, not forced." Content="Rename in the plan"
                                        Style="{StaticResource ButtonPrimary}" Width="180"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>

                        <!-- ══ VIEWS ══ -->
                        <Grid x:Name="PanelViews" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" x:Name="CreateViewsToggle" ToolTip="On, every level created by Apply also gets the plan views ticked below."
                                          Style="{StaticResource ToggleSmall}" Margin="0,0,0,8"
                                          Content="Create plan views for new levels"/>
                                <TextBlock Grid.Row="1" Text="View types" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,4"/>
                                <Border Grid.Row="2" Background="{StaticResource BrushPureWhite}"
                                        BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                        CornerRadius="5" MinHeight="104">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                                        <StackPanel x:Name="ViewTypeList"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="View template for the new views"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                <ComboBox Grid.Row="1" x:Name="ViewTemplateCombo" ToolTip="Applied to each view this tool creates. Optional."
                                          Style="{StaticResource ComboSmall}" Margin="0,0,0,8"/>
                                <Border Grid.Row="2" Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                                        Padding="10,8" MinHeight="60" Margin="0,0,0,8">
                                    <TextBlock x:Name="ChangeSummary" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Text="No changes pending."/>
                                </Border>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button x:Name="ResetBtn" Content="Discard changes"
                                            Style="{StaticResource ButtonSecondary}" Width="160"
                                            ToolTip="Throw away everything staged and go back to the model's own levels."/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ══ GUIDE ══ -->
                        <Grid x:Name="PanelGuide" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource TextH3}" Margin="0,0,0,6"
                                           Text="The short version"/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Everything you do here is staged in the table first. The model is not touched until you press Apply changes, and that lands as a single undo step. Revit stays usable the whole time — go and look at a view, come back, the window is still here."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                           Text="THE FOUR TABS, IN ORDER"/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="1 · Detect — open a section or elevation, pick &quot;Active view&quot;, press Scan for levels. Every &quot;FFL +3.500&quot; on the sheet becomes a row."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="2 · Generate — no drawing to read? Say how many levels and how tall, and they are named to match what the model already calls its levels."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="3 · Rename — tick rows in the table, then add a prefix, find-and-replace, or renumber from a template."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="4 · Views — optionally give every new level its floor / ceiling / structural plan, then read the summary of what Apply will do."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                           Text="WHAT THE DETECTOR READS"/>
                                <Border Background="{StaticResource BrushOffWhite}" CornerRadius="5"
                                        Padding="10,8">
                                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource FontMono}"
                                               Text="FFL +3.500    LVL. +3500    TOS -1.200&#x0a;± 0.00        EL. 3.50 M    RL 100.500&#x0a;2ND FLOOR (+7.000)          TERRACE +14'-6&quot;"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                           Text="THE TABLE"/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="Double-click Level name or Elevation to edit it. An elevation takes any of 3500, 3.5 m, +3.500 or 11'-6&quot;."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="Tick rows with the checkbox column; Ctrl+click and Shift+click work as usual. The buttons above the table act on what is ticked."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="State says what will happen: In model, New, Rename, Move, Delete. Confidence is how sure the detector was — green is safe, red wants a look."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Elements counts what is hosted on a level, so you know what a delete would take with it."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                           Text="THE STACK DRAWING"/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="Click a level to select it. Drag it up or down to change its elevation, rounded to the Snap value — hold Shift for no rounding."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           Text="Double-click a level to rename it. Wheel zooms, Shift+wheel pans, dragging empty space pans, Fit shows everything."/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Zoom in when levels sit on top of each other — names are hidden rather than overprinted, and the footer says how many."/>

                                <Border Background="#FEF2F2" CornerRadius="5" Padding="10,8">
                                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushCharcoalBlack}"
                                               Text="Stuck? The line under the tabs always says what this tab is for, and the line above the table always says what to do next."/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        </Grid>
                    </Grid>
                </Border>

                <!-- toolbar over the grid -->
                <Grid Grid.Row="2" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="SelectAllBtn" ToolTip="Tick every row."  Content="Tick all"        Style="{StaticResource ButtonSmall}"/>
                        <Button x:Name="ClearBtn" ToolTip="Untick everything."      Content="Clear"           Style="{StaticResource ButtonSmall}"/>
                        <Button x:Name="SelectRevitBtn" ToolTip="Select the ticked levels in Revit itself, so you can see them in a view." Content="Select in Revit" Style="{StaticResource ButtonSmall}"/>
                        <Button x:Name="OpenPlanBtn" ToolTip="Open a plan view of the first ticked level. This is why the window is modeless - it stays open while Revit changes view."   Content="Open plan"       Style="{StaticResource ButtonSmall}"/>
                        <Button x:Name="RestoreBtn" ToolTip="Undo a Mark for delete on the ticked rows."    Content="Restore"         Style="{StaticResource ButtonSmall}"/>
                        <Button x:Name="DeleteBtn" ToolTip="Stage the ticked levels for deletion. It tells you first how many elements are hosted on them. Nothing is deleted until Apply."     Content="Mark for delete" Style="{StaticResource ButtonSmallDanger}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="GridHint" Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="Double-click Name or Elevation to edit · Shift+click to range-tick"/>
                </Grid>

                <!-- the levels themselves -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                    <DataGrid x:Name="LevelGrid" ToolTip="Double-click Level name or Elevation to edit. Tick rows to act on them with the buttons above."
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BrushLightBorder}"
                              Background="{StaticResource BrushPureWhite}"
                              RowBackground="{StaticResource BrushPureWhite}"
                              AlternatingRowBackground="{StaticResource BrushOffWhite}"
                              BorderThickness="0" RowHeight="28"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              FontFamily="{StaticResource FontSans}"
                              FontSize="{StaticResource FontSizeCaption}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"   Value="{StaticResource BrushCharcoalBlack}"/>
                                <Setter Property="Foreground"   Value="{StaticResource BrushPureWhite}"/>
                                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                                <Setter Property="FontSize"     Value="{StaticResource FontSizeCaption}"/>
                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                <Setter Property="Padding"      Value="8,6"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource BrushMidGrey}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#FEF2F2"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#141414"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#FEF2F2"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#141414"/>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"  Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground"  Value="{StaticResource BrushCharcoalBlack}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- ✓ — driven by the row's own .NET IsSelected (§12.7.Q) -->
                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False"
                                                    CanUserResize="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay,
                                                              RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Editable. TwoWay so WPF definitely allows the edit, but the
                                 typed text is read off the TextBox in CellEditEnding and put
                                 through LevelPlan, which is what enforces unique names and
                                 parses "3.5 m" as readily as "3500". A rejected edit cancels
                                 the commit, and the deferred refresh rewrites every cell from
                                 the plan, so the slot never keeps a raw value. -->
                            <DataGridTextColumn Header="Level name" Width="*"
                                                Binding="{Binding Name, Mode=TwoWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Elevation (mm)" Width="104"
                                                Binding="{Binding ElevText, Mode=TwoWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMono}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="In project units" Width="112" IsReadOnly="True"
                                                Binding="{Binding ProjectText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Δ" Width="74" IsReadOnly="True"
                                                Binding="{Binding DeltaText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMono}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- state pill — string DataTriggers bind reliably (§12.7.J) -->
                            <DataGridTemplateColumn Header="State" Width="112" IsReadOnly="True"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="7,2" Margin="6,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F2F4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateText}" Value="New">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateText}" Value="Rename">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateText}" Value="Move">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateText}" Value="Rename + move">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateText}" Value="Delete">
                                                            <Setter Property="Background" Value="#E2E4EA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateText}" Value="New">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateText}" Value="Rename">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateText}" Value="Move">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateText}" Value="Rename + move">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Source" Width="116" IsReadOnly="True"
                                                Binding="{Binding SourceText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- confidence — banded so the eye can scan it -->
                            <DataGridTemplateColumn Header="Confidence" Width="86" IsReadOnly="True"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="7,2" Margin="6,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfBand}" Value="high">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfBand}" Value="mid">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfBand}" Value="low">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ConfText}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSilverSteel}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConfBand}" Value="high">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfBand}" Value="mid">
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConfBand}" Value="low">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Plans" Width="56" IsReadOnly="True"
                                                Binding="{Binding ViewsText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMono}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Elements" Width="70" IsReadOnly="True"
                                                Binding="{Binding CountText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMono}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Note" Width="220" IsReadOnly="True"
                                                Binding="{Binding NoteText, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="3" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusBar" Text="Ready"
                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushMidGrey}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" x:Name="LiveCount" Text="—"
                           Style="{StaticResource TextCaption}" Margin="12,0,16,0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshBtn" ToolTip="Re-read the model's levels, throwing away anything staged." Content="Refresh" Width="100"
                            Style="{StaticResource ButtonNeutral}" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyBtn" ToolTip="Write everything staged to the model, as one undo step." Content="Apply changes" Width="150"
                            Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0"/>
                    <Button x:Name="CloseBtn" ToolTip="Close the window. Anything staged and not applied is discarded." Content="Close" Width="90"
                            Style="{StaticResource ButtonGhost}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

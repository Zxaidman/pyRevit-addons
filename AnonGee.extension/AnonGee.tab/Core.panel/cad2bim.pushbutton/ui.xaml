                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lbl_name_column" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Round column (dia)" VerticalAlignment="Center"/>

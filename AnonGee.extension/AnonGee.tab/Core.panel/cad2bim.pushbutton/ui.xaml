                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="template" FontSize="10" Foreground="Gray"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="fields / preview" FontSize="10" Foreground="Gray" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Column (b x h)" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="lbl_name_floor" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Stair" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="tb_name_stair" Height="22" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="lbl_name_stair" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Stair waist" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="tb_name_stair_waist" Height="22" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" x:Name="lbl_name_stair_waist" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Level" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="8" Grid.Column="1" x:Name="tb_name_level" Height="22" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" x:Name="lbl_name_level" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Grid" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="9" Grid.Column="1" x:Name="tb_name_grid" Height="22" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" x:Name="lbl_name_grid" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Foundation pad (t)" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="10" Grid.Column="1" x:Name="tb_name_footing" Height="22" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" x:Name="lbl_name_footing" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox x:Name="chk_level_follow" IsChecked="True" Margin="0,10,0,0"
                                  Content="Name new levels after the model's own levels, not the template above"/>
                        <TextBlock x:Name="lbl_level_follow" TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="20,2,0,0"
                                   Text="A model whose levels are already named to a convention -- 00 GROUND LVL, 01 1ST FLOOR LVL., 02 2ND FLOOR LVL. -- gets the next line of that list (03 3RD FLOOR LVL.). Untick to use the Level template above, where {n} is the level number, {o} the same number as 1st/2nd/3rd, {e} its elevation in mm and {label} the plan title the storey came from."/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btn_name_defaults" Content="Restore defaults" Width="130" Height="24"/>
                            <TextBlock x:Name="naming_saved_text" VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="10" Foreground="Gray"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

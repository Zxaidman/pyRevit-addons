                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lbl_name_column_round" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Beam (w x d)" VerticalAlignment="Center"/>

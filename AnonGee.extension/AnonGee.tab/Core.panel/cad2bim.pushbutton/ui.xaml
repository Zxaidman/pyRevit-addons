<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="cad2bim"
        Height="720" Width="680"
        MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri">

    <Window.Resources>
        <ResourceDictionary>

            <!-- ════════════════════════════════════════════════════════════
                 AnonGee BIM Tools — Inlined Theme (Brand Guidelines section 12.3
                 strategy 2 / 12.7.B: runtime-merged dictionaries do not resolve
                 inside Revit's pyRevit sandbox, so the tokens ride in the file).
                 Token keys and values are verbatim copies of Resources/*.xaml;
                 templates follow the Multi Filter Parameter reference (12.7).
                 Declaration order is load order — never reference a key above
                 its declaration (XamlReader resolves StaticResource eagerly).
                 ════════════════════════════════════════════════════════════ -->

            <!-- ── Colors (verbatim: Resources/Colors.xaml v3.0) ── -->
            <Color x:Key="ColorVividRed">#FFE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorSilverSteel">#FFC0C8D8</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorOffWhite">#FFF4F4F6</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorLightBorder">#FFE2E4EA</Color>
            <Color x:Key="ColorSuccessGreen">#FF16A34A</Color>
            <Color x:Key="ColorCautionAmber">#FFD97706</Color>
            <Color x:Key="ColorErrorRed">#FFDC2626</Color>
            <Color x:Key="ColorInfoBlue">#FF2563EB</Color>
            <Color x:Key="ColorVividRedHover">#FFC41A1A</Color>
            <Color x:Key="ColorVividRedPressed">#FFA81515</Color>
            <Color x:Key="ColorErrorRedHover">#FFB91C1C</Color>
            <Color x:Key="ColorVividRed10">#1AE02020</Color>
            <Color x:Key="ColorOffWhiteHover">#FFE8E8EC</Color>

            <SolidColorBrush x:Key="BrushVividRed"      Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushCharcoalBlack" Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushSilverSteel"   Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPureWhite"     Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushOffWhite"      Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"       Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushLightBorder"   Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushSuccessGreen"  Color="{StaticResource ColorSuccessGreen}"/>
            <SolidColorBrush x:Key="BrushCautionAmber"  Color="{StaticResource ColorCautionAmber}"/>
            <SolidColorBrush x:Key="BrushErrorRed"      Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushInfoBlue"      Color="{StaticResource ColorInfoBlue}"/>
            <SolidColorBrush x:Key="BrushVividRedHover"    Color="{StaticResource ColorVividRedHover}"/>
            <SolidColorBrush x:Key="BrushVividRedPressed"  Color="{StaticResource ColorVividRedPressed}"/>
            <SolidColorBrush x:Key="BrushErrorRedHover"    Color="{StaticResource ColorErrorRedHover}"/>
            <SolidColorBrush x:Key="BrushSecondaryHover"   Color="{StaticResource ColorVividRed10}"/>
            <SolidColorBrush x:Key="BrushGhostHover"       Color="{StaticResource ColorOffWhiteHover}"/>
            <SolidColorBrush x:Key="BrushDisabledBackground"  Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDisabledForeground"  Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPrimaryForeground"   Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBackground" Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBorder"     Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushSecondaryForeground" Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushNeutralBackground"   Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushNeutralForeground"   Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushNeutralBorder"       Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDangerForeground"    Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushGhostForeground"     Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushInputBackground"    Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushInputBorder"        Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushInputFocusBorder"   Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushInputErrorBorder"   Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushWarningBadgeBackground" Color="#FEF9C3"/>
            <SolidColorBrush x:Key="BrushWarningBadgeText"      Color="#92400E"/>
            <SolidColorBrush x:Key="BrushTableRowHover"         Color="#FDECEA"/>
            <SolidColorBrush x:Key="BrushTableRowSelected"      Color="#FEF2F2"/>
            <SolidColorBrush x:Key="BrushTableRowSelectedBorder" Color="{StaticResource ColorVividRed}"/>

            <!-- ── Elevation (verbatim: Resources/Controls.xaml) ── -->
            <DropShadowEffect x:Key="ElevationLevel2" Color="#000000" Opacity="0.14" BlurRadius="12" ShadowDepth="4" Direction="270"/>

            <!-- ── Typography (verbatim: Resources/Typography.xaml v3.0) ── -->
            <FontFamily x:Key="FontSans">JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri</FontFamily>
            <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>
            <sys:Double x:Key="FontSizeH2">16.5</sys:Double>
            <sys:Double x:Key="FontSizeH3">11</sys:Double>
            <sys:Double x:Key="FontSizeBody">9.5</sys:Double>
            <sys:Double x:Key="FontSizeCaption">8.5</sys:Double>

            <Style x:Key="TextH2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH2}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextH2OnDark" BasedOn="{StaticResource TextH2}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushPureWhite}"/>
            </Style>
            <Style x:Key="TextH3" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH3}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextBody" TargetType="TextBlock">
                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"     Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"   Value="Normal"/>
                <Setter Property="Foreground"   Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TextLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>
            <Style x:Key="TextStatus" TargetType="TextBlock">
                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"     Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground"   Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Local derivation: help prose keeps the user's readable floor
                 (>= 12) on top of the guideline TextBody style. The floor is a
                 token so the size is declared exactly once per dialog. -->
            <sys:Double x:Key="FontSizeHelp">12</sys:Double>
            <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeHelp}"/>
            </Style>

            <!-- ── Buttons (Controls.xaml treatments; section 9.1) ── -->
            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="Height"          Value="28"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushVividRed}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushSecondaryBackground}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushSecondaryForeground}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushSecondaryBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSecondaryHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushVividRedPressed}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonNeutral" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"  Value="{StaticResource BrushNeutralBackground}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushNeutralForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushNeutralBorder}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushLightBorder}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushGhostForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushGhostHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TextBox (stroke-on-top, section 12.7.O) ── -->
            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="26"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="7,0" VerticalAlignment="Center"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputErrorBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ComboBox — editable AND non-editable (sections 12.7.C / 12.7.P) ── -->
            <Style x:Key="InputComboBox" TargetType="ComboBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="26"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ToggleButton x:Name="OpenToggle" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                      Fill="{StaticResource BrushMidGrey}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Margin="8,0,24,0"
                                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <TextBox x:Name="PART_EditableTextBox" Margin="6,0,24,0"
                                         VerticalAlignment="Center" Visibility="Hidden"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource BrushCharcoalBlack}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border MinWidth="{TemplateBinding ActualWidth}" MaxWidth="520"
                                            BorderBrush="{StaticResource BrushLightBorder}"
                                            BorderThickness="1" CornerRadius="6"
                                            Background="{StaticResource BrushPureWhite}"
                                            Effect="{StaticResource ElevationLevel2}">
                                        <ScrollViewer MaxHeight="220" Margin="4" HorizontalScrollBarVisibility="Hidden">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite"          Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Implicit ComboBoxItem (section 12.7.D — never inherit the host shell's foreground) -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily"  Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"    Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"  Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="Padding"     Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── CheckBox (implicit; section 9.4, disabled state per 10.3) ── -->
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="MinHeight"  Value="22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder" Grid.Column="0"
                                        Width="16" Height="16" CornerRadius="3"
                                        BorderBrush="{StaticResource BrushLightBorder}"
                                        BorderThickness="1"
                                        Background="{StaticResource BrushPureWhite}"
                                        VerticalAlignment="Center">
                                    <Viewbox x:Name="CheckMark" Margin="3" Visibility="Collapsed">
                                        <Path Data="M0,3.5 L3.5,7 L9,0"
                                              Stroke="{StaticResource BrushPureWhite}"
                                              StrokeThickness="1.8"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark"      Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckBoxBorder" Property="Background"  Value="{StaticResource BrushVividRed}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckBoxBorder" Property="Background"  Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BrushLightBorder}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── RadioButton (implicit; section 9.4) ── -->
            <Style TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,4,0,0">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource BrushLightBorder}"
                                             StrokeThickness="1.4" Fill="{StaticResource BrushPureWhite}"/>
                                    <Ellipse x:Name="Dot" Width="8" Height="8"
                                             Fill="{StaticResource BrushVividRed}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot"  Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Ring" Property="Stroke"     Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushVividRed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushDisabledForeground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ListBox (stroke-on-top) + selectable item (section 9.4) ── -->
            <Style x:Key="InputListBox" TargetType="ListBox">
                <Setter Property="Background"      Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushLightBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="4"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ScrollViewer Focusable="False"
                                              Margin="{TemplateBinding BorderThickness}"
                                              Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Margin"  Value="1,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushTableRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background"      Value="{StaticResource BrushTableRowSelected}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush"     Value="{StaticResource BrushTableRowSelectedBorder}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ScrollBar — both orientations (section 12.7.P) ── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width"    Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="2,0"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="2,0"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height"    Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="0,2"/>
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="0,2"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TabControl + TabItem (implicit) ── -->
            <Style TargetType="TabControl">
                <Setter Property="Background"      Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        BorderBrush="{StaticResource BrushLightBorder}"
                                        BorderThickness="0,0,0,1">
                                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,0,0,0"/>
                                </Border>
                                <Border Background="{StaticResource BrushPureWhite}">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent"
                                    BorderBrush="{StaticResource BrushVividRed}"
                                    BorderThickness="0,0,0,0" Padding="12,8">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── GroupBox (implicit; Panels.xaml SectionGroup treatment, section 9.6) ── -->
            <Style TargetType="GroupBox">
                <Setter Property="BorderBrush"     Value="{StaticResource BrushLightBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background"      Value="{StaticResource BrushPureWhite}"/>
                <Setter Property="Padding"         Value="14,12"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Style="{StaticResource TextH3}"
                                               Margin="2,0,0,8"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Section divider (Panels.xaml SectionDivider, section 9.6) ── -->
            <Style x:Key="SectionDivider" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill"   Value="{StaticResource BrushLightBorder}"/>
                <Setter Property="Margin" Value="0,16"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource BrushPureWhite}">

        <!-- Header — Charcoal band, tool title, version badge (sections 12.6 / 2.3) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushCharcoalBlack}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="cad2bim" Style="{StaticResource TextH2OnDark}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="version_text" Text="v0.13"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource BrushSilverSteel}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Rectangle DockPanel.Dock="Top" Height="3" Fill="{StaticResource BrushVividRed}"/>

        <!-- Footer — Off White action bar: status left, actions right (section 12.6) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="status_text" Text="Ready"
                           Style="{StaticResource TextStatus}" Margin="0,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" x:Name="btn_settings_save" Content="Save settings"
                        Style="{StaticResource ButtonNeutral}" Width="104"
                        ToolTip="Write every box, tick and dropdown on this dialog to a JSON file"/>
                <Button Grid.Column="2" x:Name="btn_settings_load" Content="Load settings"
                        Style="{StaticResource ButtonNeutral}" Width="104" Margin="8,0,0,0"
                        ToolTip="Put a saved settings file back on this dialog"/>
                <Button Grid.Column="3" x:Name="btn_cancel" Content="Cancel"
                        Style="{StaticResource ButtonGhost}" Width="76" Margin="8,0,0,0"/>
                <Button Grid.Column="4" x:Name="btn_run" Content="Run"
                        Style="{StaticResource ButtonPrimary}" Width="110" Margin="8,0,0,0"
                        ToolTip="Apply the layer mapping and build the selected elements"/>
            </Grid>
        </Border>

        <!-- Body: tabbed -->
        <TabControl Margin="0">

            <!-- TAB: Layers -->
            <TabItem Header="Layers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Source: " Style="{StaticResource TextLabel}"/>
                            <TextBlock x:Name="source_text" Text="-" Style="{StaticResource TextBody}" Margin="4,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Geometry layers -> element category" Style="{StaticResource TextH3}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Layer" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="1" Text="Curves" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource TextCaption}"/>
                        </Grid>
                        <Border BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                CornerRadius="5" Background="{StaticResource BrushPureWhite}"
                                Padding="8" MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="layer_rows" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Text layers -> size-mark routing" Style="{StaticResource TextH3}"
                                   Margin="0,8,0,4"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Text layer" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="1" Text="Labels" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="2" Text="Routing" Style="{StaticResource TextCaption}"/>
                        </Grid>
                        <Border BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
                                CornerRadius="5" Background="{StaticResource BrushPureWhite}"
                                Padding="8" MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="text_rows" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Build (discipline sub-tabs; Foundation and Staircase are
                 sub-tabs here, not top-level tabs) -->
            <TabItem Header="Build">
            <TabControl Margin="0">

            <!-- SUB-TAB: Build > General (run-wide picks, plus the grids;
                 they serve every element, so they live with the shared picks) -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <TextBlock Text="Shared by every element" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name parameter" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Column="1" x:Name="cb_name_param" Style="{StaticResource InputComboBox}" Margin="0,2"
                                       IsEditable="True"
                                       ToolTip="The instance parameter the CAD mark is written into - pick one or type any editable text parameter"/>
                        </Grid>
                        <TextBlock Text="Columns, beams and slabs write their CAD mark here. Type any editable text parameter name; Mark is used when the chosen one is missing on a family."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base level" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_base_level" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Top level" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_top_level" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="The level pair is shared by every element in the run, architectural ones included."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                        <Rectangle Style="{StaticResource SectionDivider}" Margin="0,16,0,8"/>
                        <CheckBox x:Name="chk_grids" Content="Create grids (from grid lines)" IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SUB-TAB: Build > Structure (columns, beams and slabs together;
                 each keeps exactly the content its own sub-tab held) -->
            <TabItem Header="Structure">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <GroupBox Header="Columns" Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="chk_columns" Content="Create columns (from column outlines)" IsChecked="True"/>
                        <Grid Margin="24,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Column family" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_family" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Round family" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_circular_family" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Base and top level for the columns are picked on the General sub-tab; they are shared by every element in the run."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,0"/>
                        </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Beams" Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="chk_beams" Content="Create beams (from beam outlines)" IsChecked="True"/>
                        <Grid Margin="24,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Beam family" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_beam_family" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Placed at the columns' top level. Depth from text marks where found, else from the chosen type."
                                       Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                        </Grid>
                        </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Slabs">
                        <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="chk_slabs" Content="Create slabs (from slab outline or beam layout)" IsChecked="True"/>
                        <Grid Margin="24,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor type" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_floor_type" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Outline from the slab-edge layer, else from closed beam bays. Thickness from THK notes duplicates the type; placed at the top level."
                                       Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                        </Grid>
                        </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SUB-TAB: Build > Architecture (a placeholder until the P3
                 walls land; it exists so the tab set already has the home
                 those elements will move into) -->
            <TabItem Header="Architecture">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <TextBlock Text="Architecture" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <TextBlock Text="Architectural walls and roofs are not built yet -- walls are on the roadmap (P3) and their options will live on this tab. Until then the run builds the structure only, ready for the architectural layers to be modelled on top of it."
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SUB-TAB: Build > Foundation -->
            <TabItem Header="Foundation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <TextBlock Text="Foundations" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <CheckBox x:Name="chk_footings" Content="Create footings (drawn foundation outlines, else pads under the columns)" IsChecked="True"/>
                        <Grid Margin="24,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Foundation type" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="cb_footing_family" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Min projection" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_footing_projection" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Depth @1m2" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_footing_thickness" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fold/sunk max step" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_max_step" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Min outline area (m2)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_fnd_min_area" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="The drawing's own foundations come first: closed outlines on the foundation layer (mapped on the Layers tab) are built exactly as drawn -- pads or whole rafts -- each sized and named by the note inside it, read from the text layer routed to &quot;foundation text&quot; on the Layers tab. A fold or sunk region inside an outline steps it: the parent is cut around the region, a slab drops in at the step depth, and a support fills the vertical face between the two soffits. A step deeper than the max step is a storey, not a step, and is refused -- the console names the outline it was refused from. An outline recovered from loose linework must reach the min area; below it is a junction sliver, not a foundation (a labelled pile cap is small, a sliver is smaller)."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,0"/>
                        <TextBlock Text="With no drawn outlines the pads are INVENTED from the columns: one per column, sketched as a Structural Foundation floor on the columns' BASE level at ZERO offset, sized column + 2 x min projection and turned to the column's long axis. Pads that OVERLAP fuse into one combined footing. Depth is the figure above at one square metre and scales with the pad's area (50mm steps, half to twice). In a multi-storey run only the LOWEST storey builds them."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,0"/>
                        <TextBlock Text="An outline is only trusted when one of them carries a foundation note, and the notes only arrive through the &quot;foundation text&quot; routing -- a drawing whose foundation text layer is not routed falls back to the invented pads SILENTLY."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SUB-TAB: Build > Staircase -->
            <TabItem Header="Staircase">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <TextBlock Text="Staircase" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <CheckBox x:Name="chk_stairs" Content="Create staircases" IsChecked="True" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stair type" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_stair_type" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stair source" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_stair_source" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="btn_draw_stairs" Content="Draw stair outlines in Revit..."
                                    Style="{StaticResource ButtonSecondary}" Width="200"
                                    ToolTip="Closes this window, lets you draw one closed outline per stair with Revit's detail lines, then comes back"/>
                            <TextBlock x:Name="stair_outline_text" Text="no outlines drawn"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource HelpText}"/>
                        </StackPanel>
                        <TextBlock Text="Auto tries the drawn stair layer first (riser lines give the exact runs, treads, widths and counts) and falls back to the generic shape below; the other sources force one path. &quot;Pick detail lines in Revit&quot; closes this window and lets you select the detail lines you drew around each stair -- they snap to the CAD link and the model, so the outline is exact and can be any shape."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,8"/>

                        <TextBlock Text="Shape (used when the CAD has no stair linework)" Style="{StaticResource TextH3}" Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="rb_shape_u" GroupName="stair_shape" IsChecked="True" Margin="0,0,8,0" ToolTip="U / dog-leg: two flights, half landing">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Canvas Width="46" Height="40">
                                        <Path Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="2" Fill="{StaticResource BrushOffWhite}" Data="M 6,4 L 20,4 L 20,36 L 40,36 L 40,22 L 26,22 L 26,18 L 6,18 Z"/>
                                        <Path Stroke="{StaticResource BrushVividRed}" StrokeThickness="1.5" Data="M 13,34 L 13,11 L 33,11"/>
                                    </Canvas>
                                    <TextBlock Text="U" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rb_shape_straight" GroupName="stair_shape" Margin="0,0,8,0" ToolTip="Straight: one flight end to end">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Canvas Width="46" Height="40">
                                        <Path Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="2" Fill="{StaticResource BrushOffWhite}" Data="M 6,12 L 40,12 L 40,28 L 6,28 Z"/>
                                        <Path Stroke="{StaticResource BrushSilverSteel}" StrokeThickness="1" Data="M 13,12 L 13,28 M 20,12 L 20,28 M 27,12 L 27,28 M 34,12 L 34,28"/>
                                        <Path Stroke="{StaticResource BrushVividRed}" StrokeThickness="1.5" Data="M 6,20 L 40,20"/>
                                    </Canvas>
                                    <TextBlock Text="Straight" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rb_shape_l" GroupName="stair_shape" Margin="0,0,8,0" ToolTip="L: two flights at 90 degrees, corner landing">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Canvas Width="46" Height="40">
                                        <Path Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="2" Fill="{StaticResource BrushOffWhite}" Data="M 6,22 L 30,22 L 30,4 L 40,4 L 40,36 L 6,36 Z"/>
                                        <Path Stroke="{StaticResource BrushVividRed}" StrokeThickness="1.5" Data="M 9,32 L 35,32 L 35,8"/>
                                    </Canvas>
                                    <TextBlock Text="L" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rb_shape_c" GroupName="stair_shape" Margin="0,0,8,0" ToolTip="C: three flights around three sides">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Canvas Width="46" Height="40">
                                        <Path Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="2" Fill="{StaticResource BrushOffWhite}" Data="M 6,4 L 40,4 L 40,14 L 18,14 L 18,26 L 40,26 L 40,36 L 6,36 Z"/>
                                        <Path Stroke="{StaticResource BrushVividRed}" StrokeThickness="1.5" Data="M 36,9 L 11,9 L 11,31 L 36,31"/>
                                    </Canvas>
                                    <TextBlock Text="C" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rb_shape_circular" GroupName="stair_shape" ToolTip="Circular: one spiral flight around the bay centre">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Canvas Width="46" Height="40">
                                        <Ellipse Canvas.Left="6" Canvas.Top="2" Width="34" Height="34" Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="2" Fill="{StaticResource BrushOffWhite}"/>
                                        <Ellipse Canvas.Left="18" Canvas.Top="14" Width="10" Height="10" Stroke="{StaticResource BrushCharcoalBlack}" StrokeThickness="1.5" Fill="{StaticResource BrushPureWhite}"/>
                                        <Path Stroke="{StaticResource BrushSilverSteel}" StrokeThickness="1" Data="M 23,2 L 23,14 M 40,19 L 28,19 M 23,36 L 23,24 M 6,19 L 18,19 M 11,7 L 19,15 M 35,7 L 27,15"/>
                                    </Canvas>
                                    <TextBlock Text="Circular" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Floor height: " Style="{StaticResource TextLabel}"/>
                            <TextBlock x:Name="stair_floor_text" Text="-" Style="{StaticResource TextBody}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Riser count" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_stair_count" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Riser height (max)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_stair_riser" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tread depth" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_stair_tread" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Run width" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_stair_width" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Landing depth" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_stair_landing" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Waist thickness" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_stair_waist" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Riser count defaults to storey / riser rounded up (20 for 3000 / 150) and refreshes when the levels change; edit it to override. Landing depth 0 = run width. A DN/UP note picks the landing end; the arrival landing at the top spans the parallel flights like the half landing."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            </TabControl>
            </TabItem>

            <!-- TAB: Multi-storey -->
            <TabItem Header="Multi-storey">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">
                        <CheckBox x:Name="chk_multistorey" Content="This DXF holds several floor plans -- build them as storeys" IsChecked="False"/>
                        <TextBlock Text="Draw one rectangle around each floor plan on a BOUNDARY layer, and one marker inside each rectangle on an ORIGIN layer. Every plan is moved so its marker lands on the model origin, so the storeys stack instead of sitting side by side. Pick the two layers below -- any names work."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,8"/>
                        <Grid Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Boundary layer" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_boundary_layer" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Origin layer" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_origin_layer" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Storey height (mm)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_storey_height" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Storeys are ordered by the plan title inside each rectangle (GROUND FLOOR PLAN, LEVEL 2, TERRACE) and fall back to the sheet layout -- top row first, then left to right. The lowest storey builds onto the chosen base level and each one above it onto the next level up; levels are created at the storey height when the model runs out of them."
                                   Style="{StaticResource HelpText}" Margin="24,8,0,0"/>
                        <TextBlock x:Name="multistorey_preview" Text="" Style="{StaticResource HelpText}" Margin="24,8,0,0"/>

                        <TextBlock Text="Detected storeys" Style="{StaticResource TextH3}" Margin="24,16,0,4"/>
                        <TextBlock Text="One row per storey, BOTTOM-UP: the first row is built first, on the base level. Plan is which detected floor drawing that storey uses -- pick the same plan on several rows to repeat a typical floor. Height is that storey's floor-to-floor rise (blank uses the storey height above); Repeat is how many storeys one row builds, auto-filled from a title like &quot;TYPICAL FLOOR PLAN (2ND TO 8TH FLOOR)&quot;. Click a row to select it, then use the buttons below to move, add or remove that storey."
                                   Style="{StaticResource HelpText}" Margin="24,0,0,4"/>
                        <Grid Margin="28,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Build" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="1" Text="No." Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="2" Text="Plan drawing" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="3" Text="Height" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="4" Text="Repeat" Style="{StaticResource TextCaption}"/>
                        </Grid>
                        <ListBox x:Name="storey_rows" Style="{StaticResource InputListBox}"
                                 Margin="24,0,0,0" MaxHeight="190"
                                 HorizontalContentAlignment="Stretch"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                            <Button x:Name="btn_storey_up" Content="Move up" Style="{StaticResource ButtonNeutral}" Width="82"/>
                            <Button x:Name="btn_storey_down" Content="Move down" Style="{StaticResource ButtonNeutral}" Width="92" Margin="8,0,0,0"/>
                            <Button x:Name="btn_storey_add" Content="Add storey" Style="{StaticResource ButtonNeutral}" Width="92" Margin="8,0,0,0"/>
                            <Button x:Name="btn_storey_remove" Content="Remove" Style="{StaticResource ButtonNeutral}" Width="82" Margin="8,0,0,0"/>
                            <TextBlock x:Name="storey_selection_text" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Tolerances -->
            <TabItem Header="Tolerances">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">

                        <TextBlock Text="Grouped by the element each number affects. Everything is millimetres unless a row says otherwise."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,8"/>

                        <TextBlock Text="GENERAL" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Std snap tolerance" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_snap" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Text mark radius" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_markrad" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Grid snap distance" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_grid_snap" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Grid snap distance is how far a text-corrected column centre may move to land on a grid line (columns sit on grid intersections)."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>

                        <TextBlock Text="COLUMNS" Style="{StaticResource TextH3}" Margin="0,16,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="min" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="max" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Column b" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_colb_min" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="1" Grid.Column="2" x:Name="sl_colb_min" Minimum="0" Maximum="2000" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_colb_max" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="1" Grid.Column="4" x:Name="sl_colb_max" Minimum="0" Maximum="2000" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Column h" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_colh_min" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="2" Grid.Column="2" x:Name="sl_colh_min" Minimum="0" Maximum="20000" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_colh_max" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="2" Grid.Column="4" x:Name="sl_colh_max" Minimum="0" Maximum="20000" Margin="8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Region max side" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_region" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Circle dia min" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_circ_min" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Circle dia max" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_circ_max" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Standard b x h" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_std_columns" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Combined label reach" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_face_reach" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Combined size match" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_face_size" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Region max side also gates the footing fallback: a region wider than this reads as a lift or stair core, not a column, so no pad is invented under it."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
                        <TextBlock Text="A COMBINED column -- a wall-column carrying several columns, drawn as one merged outline -- is recovered from the faces of its linework, but only where a size label agrees with what was walked. Label reach is how far outside a member its label may sit; size match is how far the drawn size may differ from the labelled one."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>

                        <TextBlock Text="BEAMS" Style="{StaticResource TextH3}" Margin="0,16,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="min" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="max" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Beam width" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_beam_min" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="1" Grid.Column="2" x:Name="sl_beam_min" Minimum="0" Maximum="2000" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_beam_max" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <Slider    Grid.Row="1" Grid.Column="4" x:Name="sl_beam_max" Minimum="0" Maximum="2000" Margin="8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pair width min" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_pair_min" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Pair width max" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_pair_max" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pair min overlap" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_pair_overlap" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Parallel angle (deg)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_parallel_angle" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Arc junction radius" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_junction_tol" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Concentric arc tolerance" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_concentric_tol" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Standard widths" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="tb_std_beams" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                        </Grid>
                        <TextBlock Text="A drawn beam is two parallel lines: they must run alongside each other for at least the pair min overlap and lean no more than the parallel angle. An arc centred within the junction radius of a round column is a junction fillet, not a beam edge; two arcs whose centres sit within the concentric tolerance are the two edges of one curved beam."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>

                        <TextBlock Text="SLABS" Style="{StaticResource TextH3}" Margin="0,16,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Node weld distance" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_slab_snap" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Edge heal gap" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_slab_heal" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Loose edge chain gap" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_slab_chain" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Min bay width" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_slab_width" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Min corner step" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_slab_step" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Min noted bay area (m2)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_slab_note_area" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Node weld distance decides when two boundary points are the same junction; edge heal closes small gaps; min corner step is the smallest jog that is real geometry rather than drafting noise. Min noted bay area is the smallest slab recovered from the beam graph for a thickness note whose outline was never drawn."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>

                        <TextBlock Text="STAIRCASE" Style="{StaticResource TextH3}" Margin="0,16,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stair cluster gap" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_stair_cluster" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Drawn tread min" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_tread_min" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Drawn tread max" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_tread_max" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Arrival landing merge" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_arrival_merge" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="The drawn tread range is what a riser spacing must fall inside to count as a flight; stair cluster gap groups drawn stair lines into one staircase."
                                   Style="{StaticResource HelpText}" Margin="0,4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Output & Graphics -->
            <TabItem Header="Output &amp; Graphics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">

                        <TextBlock Text="Materials" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <TextBlock Text="Written onto both the TYPE and the INSTANCE of everything this run creates -- a family may expose its material on either. A floor (and a foundation pad) takes it on its structural layer; a stair on its tread/riser/landing/support parameters. Leave a row as (unchanged) to keep whatever the family already has."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Columns" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_mat_column" Style="{StaticResource InputComboBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Beams" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="3" x:Name="cb_mat_beam" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Slabs" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_mat_slab" Style="{StaticResource InputComboBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Stairs" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="cb_mat_stair" Style="{StaticResource InputComboBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Footings" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cb_mat_footing" Style="{StaticResource InputComboBox}" Margin="0,2,8,2"/>
                        </Grid>

                        <TextBlock Text="Concrete grade" Style="{StaticResource TextH3}" Margin="0,16,0,4"/>
                        <TextBlock Text="Written to the parameter named below on every element this run creates. Leave a grade blank to write nothing for that element. Tick &quot;append to the name&quot; to add it to the mark instead of a parameter of its own, so C12 becomes C12 (M30) in whichever parameter the Build tab names."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Columns" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_grade_column" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Beams" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_grade_beam" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Slabs" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_grade_slab" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Stairs" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_grade_stair" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Footings" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_grade_footing" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Parameter" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="2" Grid.Column="3" x:Name="cb_grade_param" Style="{StaticResource InputComboBox}" Margin="0,2" IsEditable="True"/>
                            <CheckBox  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="chk_grade_in_mark"
                                       Content="Append the grade to the element name instead (C12 -&gt; C12 (M30))"
                                       Margin="0,8,0,0"/>
                        </Grid>

                        <Rectangle Style="{StaticResource SectionDivider}" Margin="0,16,0,8"/>
                        <TextBlock Text="View filters" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <CheckBox x:Name="chk_view_filters" Content="Colour what was built in every open view (one filter per element kind)" IsChecked="True"/>
                        <TextBlock Text="Adds a reusable cad2bim view filter per category, in light tints -- columns blue, beams terracotta, slabs green, stairs violet, footings sand, grids grey -- to each view you have open. Views driven by a template are left alone; the template owns their filters."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,4"/>
                        <Grid Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Surface transparency" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_filter_transparency" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="0 = solid fill, 100 = invisible" VerticalAlignment="Center" Style="{StaticResource HelpText}"/>
                            <CheckBox  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="chk_filter_lines"
                                       Content="Colour the LINES too (otherwise only the patterns are coloured)"
                                       Margin="0,4,0,0"/>
                        </Grid>

                        <Rectangle Style="{StaticResource SectionDivider}" Margin="0,16,0,8"/>
                        <TextBlock Text="Output" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <CheckBox x:Name="chk_export" Content="Export parsed result to JSON (compact)" IsChecked="True"/>
                        <TextBlock Text="A multi-storey run writes ONE file with a section per storey."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,4"/>
                        <Grid Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Compare match radius (diagnostic only)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_compare" Style="{StaticResource InputTextBox}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="How close a Revit-imported record and its raw-DXF twin must sit to count as the same member in the import-fidelity report. It changes what the console says, never what is built."
                                   Style="{StaticResource HelpText}" Margin="24,4,0,0"/>

                        <Rectangle Style="{StaticResource SectionDivider}" Margin="0,16,0,8"/>
                        <TextBlock Text="Advanced" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <TextBlock Text="The module constants the tabs above deliberately do not carry: probe reaches, sliver thresholds, chamfer and coverage limits. Each is explained in the window, and every change is remembered across Revit sessions until Reset. Meant for a user tuning the reader against an office's own drawings."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,4"/>
                        <Button x:Name="btn_advanced" Content="Advanced..." Style="{StaticResource ButtonSecondary}" Width="130" HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Naming">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="16,12">

                        <TextBlock Text="Auto-created family type names" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                        <TextBlock Text="When a size is not already in the model this tool duplicates the picked family and names the new type from these templates; levels this run creates and grids it names follow the same rule. Sizes are whole millimetres. Level takes {n} {e} {label} (index, elevation, plan title) and Grid takes {name} (the CAD bubble, or the A/B/1/2 convention). These are remembered between Revit sessions, along with the standard sizes on the Tolerances tab."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="template" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="fields / preview" Style="{StaticResource TextCaption}" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Column (b x h)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_name_column" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lbl_name_column" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Round column (dia)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_name_column_round" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lbl_name_column_round" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Beam (w x d)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="tb_name_beam" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="lbl_name_beam" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Beam (width only)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="tb_name_beam_width" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="lbl_name_beam_width" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Floor (thickness)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="tb_name_floor" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="lbl_name_floor" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Stair" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="tb_name_stair" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="lbl_name_stair" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Stair waist" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="tb_name_stair_waist" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" x:Name="lbl_name_stair_waist" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Level" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="8" Grid.Column="1" x:Name="tb_name_level" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" x:Name="lbl_name_level" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Grid" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="9" Grid.Column="1" x:Name="tb_name_grid" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" x:Name="lbl_name_grid" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Foundation pad (t)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="10" Grid.Column="1" x:Name="tb_name_footing" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" x:Name="lbl_name_footing" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Raft (t)" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="11" Grid.Column="1" x:Name="tb_name_raft" Style="{StaticResource InputTextBox}" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="11" Grid.Column="2" x:Name="lbl_name_raft" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox x:Name="chk_level_follow" IsChecked="True" Margin="0,16,0,0"
                                  Content="Name new levels after the model's own levels, not the template above"/>
                        <TextBlock x:Name="lbl_level_follow" Style="{StaticResource HelpText}" Margin="24,4,0,0"
                                   Text="A model whose levels are already named to a convention -- 00 GROUND LVL, 01 1ST FLOOR LVL., 02 2ND FLOOR LVL. -- gets the next line of that list (03 3RD FLOOR LVL.). Untick to use the Level template above, where {n} is the level number, {o} the same number as 1st/2nd/3rd, {e} its elevation in mm and {label} the plan title the storey came from."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="btn_name_defaults" Content="Restore defaults" Style="{StaticResource ButtonNeutral}" Width="130"/>
                            <TextBlock x:Name="naming_saved_text" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="lbl_name_beam_width" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Floor (thickness)" VerticalAlignment="Center"/>

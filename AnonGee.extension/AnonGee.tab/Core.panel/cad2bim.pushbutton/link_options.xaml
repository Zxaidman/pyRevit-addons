<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link DXF Formats"
        Height="260" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Active view: " FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="tb_active_view" Text="-" FontWeight="Bold" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="link_version_text" Text="v0.13"
                       VerticalAlignment="Bottom"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="DXF file" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" x:Name="tb_path" Height="24" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button    Grid.Column="2" x:Name="btn_browse" Content="Browse" Width="84" Height="24" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Import Units" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1" x:Name="cb_unit" Height="24"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Positioning" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1" x:Name="cb_placement" Height="24"/>
        </Grid>

        <CheckBox Grid.Row="4" x:Name="chk_view_only" Margin="0,4,0,0"
                  Content="Active view only (otherwise all views)"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btn_link"   Content="Link" Width="110" Height="26"/>
            <Button x:Name="btn_cancel" Content="Cancel" Width="84" Height="26" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="cad2bim -- Advanced settings"
        Height="640" Width="720"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri">

    <Window.Resources>
        <ResourceDictionary>

            <!-- ════════════════════════════════════════════════════════════
                 AnonGee BIM Tools — Inlined Theme (Brand Guidelines section 12.3
                 strategy 2 / 12.7.B: runtime-merged dictionaries do not resolve
                 inside Revit's pyRevit sandbox, so the tokens ride in the file).
                 Token keys and values are verbatim copies of Resources/*.xaml;
                 templates follow the Multi Filter Parameter reference (12.7).
                 Declaration order is load order — never reference a key above
                 its declaration (XamlReader resolves StaticResource eagerly).
                 ════════════════════════════════════════════════════════════ -->

            <!-- ── Colors (verbatim: Resources/Colors.xaml v3.0) ── -->
            <Color x:Key="ColorVividRed">#FFE02020</Color>
            <Color x:Key="ColorCharcoalBlack">#FF141414</Color>
            <Color x:Key="ColorSilverSteel">#FFC0C8D8</Color>
            <Color x:Key="ColorPureWhite">#FFFFFFFF</Color>
            <Color x:Key="ColorOffWhite">#FFF4F4F6</Color>
            <Color x:Key="ColorMidGrey">#FF6B7280</Color>
            <Color x:Key="ColorLightBorder">#FFE2E4EA</Color>
            <Color x:Key="ColorSuccessGreen">#FF16A34A</Color>
            <Color x:Key="ColorCautionAmber">#FFD97706</Color>
            <Color x:Key="ColorErrorRed">#FFDC2626</Color>
            <Color x:Key="ColorInfoBlue">#FF2563EB</Color>
            <Color x:Key="ColorVividRedHover">#FFC41A1A</Color>
            <Color x:Key="ColorVividRedPressed">#FFA81515</Color>
            <Color x:Key="ColorErrorRedHover">#FFB91C1C</Color>
            <Color x:Key="ColorVividRed10">#1AE02020</Color>
            <Color x:Key="ColorOffWhiteHover">#FFE8E8EC</Color>

            <SolidColorBrush x:Key="BrushVividRed"      Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushCharcoalBlack" Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushSilverSteel"   Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPureWhite"     Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushOffWhite"      Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushMidGrey"       Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushLightBorder"   Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushSuccessGreen"  Color="{StaticResource ColorSuccessGreen}"/>
            <SolidColorBrush x:Key="BrushCautionAmber"  Color="{StaticResource ColorCautionAmber}"/>
            <SolidColorBrush x:Key="BrushErrorRed"      Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushInfoBlue"      Color="{StaticResource ColorInfoBlue}"/>
            <SolidColorBrush x:Key="BrushVividRedHover"    Color="{StaticResource ColorVividRedHover}"/>
            <SolidColorBrush x:Key="BrushVividRedPressed"  Color="{StaticResource ColorVividRedPressed}"/>
            <SolidColorBrush x:Key="BrushErrorRedHover"    Color="{StaticResource ColorErrorRedHover}"/>
            <SolidColorBrush x:Key="BrushSecondaryHover"   Color="{StaticResource ColorVividRed10}"/>
            <SolidColorBrush x:Key="BrushGhostHover"       Color="{StaticResource ColorOffWhiteHover}"/>
            <SolidColorBrush x:Key="BrushDisabledBackground"  Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDisabledForeground"  Color="{StaticResource ColorSilverSteel}"/>
            <SolidColorBrush x:Key="BrushPrimaryForeground"   Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBackground" Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushSecondaryBorder"     Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushSecondaryForeground" Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushNeutralBackground"   Color="{StaticResource ColorOffWhite}"/>
            <SolidColorBrush x:Key="BrushNeutralForeground"   Color="{StaticResource ColorCharcoalBlack}"/>
            <SolidColorBrush x:Key="BrushNeutralBorder"       Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushDangerForeground"    Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushGhostForeground"     Color="{StaticResource ColorMidGrey}"/>
            <SolidColorBrush x:Key="BrushInputBackground"    Color="{StaticResource ColorPureWhite}"/>
            <SolidColorBrush x:Key="BrushInputBorder"        Color="{StaticResource ColorLightBorder}"/>
            <SolidColorBrush x:Key="BrushInputFocusBorder"   Color="{StaticResource ColorVividRed}"/>
            <SolidColorBrush x:Key="BrushInputErrorBorder"   Color="{StaticResource ColorErrorRed}"/>
            <SolidColorBrush x:Key="BrushWarningBadgeBackground" Color="#FEF9C3"/>
            <SolidColorBrush x:Key="BrushWarningBadgeText"      Color="#92400E"/>
            <SolidColorBrush x:Key="BrushTableRowHover"         Color="#FDECEA"/>
            <SolidColorBrush x:Key="BrushTableRowSelected"      Color="#FEF2F2"/>
            <SolidColorBrush x:Key="BrushTableRowSelectedBorder" Color="{StaticResource ColorVividRed}"/>

            <!-- ── Elevation (verbatim: Resources/Controls.xaml) ── -->
            <DropShadowEffect x:Key="ElevationLevel2" Color="#000000" Opacity="0.14" BlurRadius="12" ShadowDepth="4" Direction="270"/>

            <!-- ── Typography (verbatim: Resources/Typography.xaml v3.0) ── -->
            <FontFamily x:Key="FontSans">JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri</FontFamily>
            <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New</FontFamily>
            <sys:Double x:Key="FontSizeH2">16.5</sys:Double>
            <sys:Double x:Key="FontSizeH3">11</sys:Double>
            <sys:Double x:Key="FontSizeBody">9.5</sys:Double>
            <sys:Double x:Key="FontSizeCaption">8.5</sys:Double>

            <Style x:Key="TextH2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH2}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextH2OnDark" BasedOn="{StaticResource TextH2}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushPureWhite}"/>
            </Style>
            <Style x:Key="TextH3" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeH3}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextBody" TargetType="TextBlock">
                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"     Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"   Value="Normal"/>
                <Setter Property="Foreground"   Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TextLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushCharcoalBlack}"/>
            </Style>
            <Style x:Key="TextCaption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"   Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushMidGrey}"/>
            </Style>
            <Style x:Key="TextStatus" TargetType="TextBlock">
                <Setter Property="FontFamily"   Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"     Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground"   Value="{StaticResource BrushMidGrey}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Local derivation: help prose keeps the user's readable floor
                 (>= 12) on top of the guideline TextBody style. The floor is a
                 token so the size is declared exactly once per dialog. -->
            <sys:Double x:Key="FontSizeHelp">12</sys:Double>
            <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeHelp}"/>
            </Style>

            <!-- ── Warning banner pieces (sections 8.2 / 9.5 / 10.4 / 11.4) ── -->
            <Geometry x:Key="IconAlertTriangle">M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</Geometry>
            <Style x:Key="WarningText" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                <Setter Property="FontSize"   Value="{StaticResource FontSizeHelp}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushWarningBadgeText}"/>
            </Style>

            <!-- ── Buttons (Controls.xaml treatments; section 9.1) ── -->
            <Style x:Key="ButtonBaseStyle" TargetType="Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="Height"          Value="28"/>
                <Setter Property="FontFamily"      Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushVividRed}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="{StaticResource BrushSecondaryBackground}"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushSecondaryForeground}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BrushSecondaryBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSecondaryHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushVividRedPressed}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushVividRedPressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDisabledBackground}"/>
                        <Setter Property="Foreground"  Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonNeutral" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"  Value="{StaticResource BrushNeutralBackground}"/>
                <Setter Property="Foreground"  Value="{StaticResource BrushNeutralForeground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushNeutralBorder}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushLightBorder}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource BrushGhostForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushGhostHover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TextBox (stroke-on-top, section 12.7.O) ── -->
            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="FontFamily"               Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize"                 Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Foreground"               Value="{StaticResource BrushCharcoalBlack}"/>
                <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BrushInputBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Height"                   Value="26"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="7,0" VerticalAlignment="Center"/>
                                <Border x:Name="Stroke" CornerRadius="5"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputFocusBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="Stroke" Property="BorderBrush"     Value="{StaticResource BrushInputErrorBorder}"/>
                                    <Setter TargetName="Stroke" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushDisabledBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushDisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ScrollBar — both orientations (section 12.7.P) ── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width"    Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="2,0"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="2,0"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height"    Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Border Background="{StaticResource BrushOffWhite}" CornerRadius="4" Margin="0,2"/>
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                              Opacity="0" Background="Transparent" BorderThickness="0"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBd" CornerRadius="3" Margin="0,2"
                                                                    Background="{StaticResource BrushSilverSteel}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushCharcoalBlack}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushVividRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- The rows are NOT declared here: they render advanced.REGISTRY, the
         one list of module tunables, so a constant registered tomorrow gets
         its row the day it appears. This file is the shell round them. -->

    <DockPanel LastChildFill="True" Background="{StaticResource BrushPureWhite}">

        <!-- Header — Charcoal band, tool title, version badge (sections 12.6 / 2.3) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushCharcoalBlack}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Advanced settings" Style="{StaticResource TextH2OnDark}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="advanced_version_text" Text="v0.13"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource BrushSilverSteel}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Rectangle DockPanel.Dock="Top" Height="3" Fill="{StaticResource BrushVividRed}"/>

        <!-- Warning banner — Caution Amber pair + icon, never colour alone
             (sections 8.2 / 9.5 / 10.4 / 11.4) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushWarningBadgeBackground}"
                BorderBrush="{StaticResource BrushCautionAmber}" BorderThickness="1"
                CornerRadius="5" Padding="8" Margin="16,16,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconAlertTriangle}"
                      Stroke="{StaticResource BrushCautionAmber}" StrokeThickness="1.5"
                      Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
                      VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBlock Grid.Column="1" x:Name="advanced_warning_text" Style="{StaticResource WarningText}"
                           Text="These change how drawings are read. The defaults are measured against the fixture corpus; a wrong value here fails quietly. Reset restores every default."/>
            </Grid>
        </Border>

        <!-- Footer — Reset stays clear of the confirm pair (section 12.6) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_adv_reset"  Content="Reset all to defaults"
                        Style="{StaticResource ButtonNeutral}" Width="150"/>
                <Button x:Name="btn_adv_cancel" Content="Cancel"
                        Style="{StaticResource ButtonGhost}" Width="84" Margin="8,0,0,0"/>
                <Button x:Name="btn_adv_apply"  Content="Use these values"
                        Style="{StaticResource ButtonPrimary}" Width="140" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,8" Margin="0,8,0,0">
            <StackPanel x:Name="advanced_rows" Orientation="Vertical"/>
        </ScrollViewer>

    </DockPanel>
</Window>

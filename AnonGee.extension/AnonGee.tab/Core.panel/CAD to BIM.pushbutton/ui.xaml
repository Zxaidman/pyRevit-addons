<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cad2bim"
        Height="640" Width="560"
        MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="CAD2BIM" FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="version_text" Text="v0.13"
                       VerticalAlignment="Center"/>
        </Grid>
        <Separator DockPanel.Dock="Top"/>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="12,6,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="status_text" Text="Ready"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btn_run" Content="Run" Width="120" Height="24"
                    ToolTip="Apply the layer mapping and build the selected elements"/>
            <Button Grid.Column="2" x:Name="btn_cancel" Content="Cancel" Width="76" Height="24"
                    Margin="8,0,0,0"/>
        </Grid>

        <!-- Body: tabbed -->
        <TabControl Margin="8,4,8,4">

            <!-- TAB 1: Layers -->
            <TabItem Header="Layers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Source: " FontWeight="Bold"/>
                            <TextBlock x:Name="source_text" Text="-" Margin="4,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Geometry layers -> element category" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Layer"/>
                            <TextBlock Grid.Column="1" Text="Curves"/>
                            <TextBlock Grid.Column="2" Text="Category"/>
                        </Grid>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="4" MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="layer_rows" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Text layers -> size-mark routing" FontWeight="Bold"
                                   Margin="0,8,0,2"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Text layer"/>
                            <TextBlock Grid.Column="1" Text="Labels"/>
                            <TextBlock Grid.Column="2" Text="Routing"/>
                        </Grid>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="4" MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="text_rows" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Build -->
            <TabItem Header="Build">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="6">
                        <CheckBox x:Name="chk_grids"   Content="Create grids (from grid lines)" IsChecked="True"/>
                        <CheckBox x:Name="chk_columns" Content="Create columns (from column outlines)" IsChecked="True" Margin="0,6,0,0"/>
                        <Grid Margin="20,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Column family" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_family" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Round family" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cb_circular_family" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Base level" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cb_base_level" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Top level" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="cb_top_level" Height="22" Margin="0,1"/>
                        </Grid>
                        <CheckBox x:Name="chk_beams"   Content="Create beams (from beam outlines)" IsChecked="True" Margin="0,6,0,0"/>
                        <Grid Margin="20,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Beam family" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_beam_family" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Placed at the columns' top level. Depth from text marks where found, else from the chosen type."
                                       TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,1,0,0"/>
                        </Grid>
                        <CheckBox x:Name="chk_slabs"   Content="Create slabs (from slab outline or beam layout)" IsChecked="True" Margin="0,6,0,0"/>
                        <Grid Margin="20,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Floor type" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_floor_type" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Outline from the slab-edge layer, else from closed beam bays. Thickness from THK notes duplicates the type; placed at the top level."
                                       TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,1,0,0"/>
                        </Grid>
                        <CheckBox x:Name="chk_stairs"  Content="Create staircases (from stair linework or STAIRCASE / ST-n texts)" IsChecked="True" Margin="0,6,0,0"/>
                        <Grid Margin="20,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stair type" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cb_stair_type" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Runs from the stair layer when drawn, else a dog-leg in the bay holding the text; numbers from the Staircase tab. Base to top level."
                                       TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,1,0,0"/>
                        </Grid>
                        <CheckBox x:Name="chk_export"  Content="Export parsed result to JSON (compact)" IsChecked="True" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Staircase -->
            <TabItem Header="Staircase">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="6">
                        <TextBlock Text="Generic staircase (mm)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stair source" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Column="1" x:Name="cb_stair_source" Height="22" Margin="0,1"/>
                        </Grid>
                        <TextBlock Text="Auto tries the drawn stair layer first (riser lines give the exact runs, treads, widths and counts) and falls back to the text mode; the other two force one source. Text mode lays a generic dog-leg inside the bay holding a STAIRCASE / ST-n note, sized by these numbers. A riser count &gt; 0 is ABSOLUTE and the riser height syncs to storey / count."
                                   TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Floor height: " FontWeight="Bold"/>
                            <TextBlock x:Name="stair_floor_text" Text="-"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Riser count" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_stair_count" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Riser height (max)" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_stair_riser" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tread depth" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_stair_tread" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Run width" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_stair_width" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Landing depth" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_stair_landing" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Waist thickness" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_stair_waist" Height="22" Margin="0,1"/>
                        </Grid>
                        <TextBlock Text="Riser count defaults to storey / riser rounded up (20 for 3000 / 150) and refreshes when the levels change; edit it to override. Landing depth 0 = run width. A DN/UP note picks the landing end; the arrival landing at the top spans the parallel flights like the half landing."
                                   TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Units & Tolerances -->
            <TabItem Header="Units &amp; Tolerances">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="6">

                        <TextBlock Text="Acceptance limits (mm)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="min" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="max" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Beam width" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_beam_min" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="1" Grid.Column="2" x:Name="sl_beam_min" Minimum="0" Maximum="2000" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_beam_max" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="1" Grid.Column="4" x:Name="sl_beam_max" Minimum="0" Maximum="2000" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Column b" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_colb_min" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="2" Grid.Column="2" x:Name="sl_colb_min" Minimum="0" Maximum="2000" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_colb_max" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="2" Grid.Column="4" x:Name="sl_colb_max" Minimum="0" Maximum="2000" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Column h" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="tb_colh_min" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="3" Grid.Column="2" x:Name="sl_colh_min" Minimum="0" Maximum="20000" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="3" x:Name="tb_colh_max" Height="22" Margin="0,1"/>
                            <Slider    Grid.Row="3" Grid.Column="4" x:Name="sl_colh_max" Minimum="0" Maximum="20000" Margin="6,0" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Standard sizes (mm)" FontWeight="Bold" Margin="0,8,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Columns b x h" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_std_columns" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Beam widths" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_std_beams" Height="22" Margin="0,1"/>
                        </Grid>

                        <TextBlock Text="Tolerances (mm unless noted)" FontWeight="Bold" Margin="0,8,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Std snap tolerance" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="tb_snap" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Text mark radius" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="tb_markrad" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Compare match radius" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="tb_compare" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Column region max side" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" x:Name="tb_region" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Circle dia min" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="tb_circ_min" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Circle dia max" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="3" x:Name="tb_circ_max" Height="22" Margin="0,1"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Beam pair width min" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="tb_pair_min" Height="22" Margin="0,1,8,1"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Beam pair width max" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="3" Grid.Column="3" x:Name="tb_pair_max" Height="22" Margin="0,1"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
